# Copy this file to .env before running: docker compose up --build
# Never commit .env. Replace every placeholder with a real local secret.

POSTGRES_USER=home_energy
POSTGRES_PASSWORD=change-this-postgres-password

# Generate one matching RSA key pair. Private is PKCS#8 Base64 DER;
# public is X.509 Base64 DER.
JWT_PRIVATE_KEY_BASE64=replace-with-pkcs8-private-key-base64
JWT_PUBLIC_KEY_BASE64=replace-with-x509-public-key-base64

# Shared only for notification-service -> user-service internal calls.
USER_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Shared only for ingestion-service -> device-service internal calls.
DEVICE_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Shared only for insight-service -> usage-service internal calls.
USAGE_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Groq credentials used by insight-service through the OpenAI-compatible API.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

INFLUXDB_USERNAME=home_energy
INFLUXDB_PASSWORD=change-this-influxdb-password
INFLUXDB_TOKEN=replace-with-a-long-random-influx-token
INFLUXDB_ORG=home-energy-tracker
INFLUXDB_BUCKET=energy-usage

# Local browser frontend origin accepted by API Gateway.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Interactive API documentation for local/test. Disable both in production.
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true
